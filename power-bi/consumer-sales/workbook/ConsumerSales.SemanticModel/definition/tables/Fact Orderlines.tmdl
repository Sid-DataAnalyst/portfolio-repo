			let
			  Source = #"T Orderlines",
			  #"Changed column type" = Table.TransformColumnTypes(Source, {{"OrderDate", type datetime}}),
			  #"Filtered rows" = Table.SelectRows(#"Changed column type", each [OrderDate] >= RangeStart and [OrderDate] < RangeEnd)
			in
			  #"Filtered rows"

