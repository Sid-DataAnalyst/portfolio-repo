	refreshPolicy
		policyType: basic
		rollingWindowGranularity: year
		rollingWindowPeriods: 2
		incrementalGranularity: day
		incrementalPeriods: 30
		pollingExpression = let MaxOrderDate = List.Max(#"Fact Orderlines"[OrderDate]), accountForNull = if MaxOrderDate = null then #datetime(1901, 01, 01, 00, 00, 00) else MaxOrderDate in accountForNull
